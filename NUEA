                    bgui = Instance.new("BillboardGui")
                    bgui.Name = "PAID_NameESP"
                    bgui.Size = UDim2.new(0, 160, 0, 40)
                    bgui.StudsOffset = Vector3.new(0, 2.8, 0) -- ลอยเหนือหัวเพื่อไม่บังตัวผู้เล่น
                    bgui.AlwaysOnTop = true
                    bgui.Parent = head

                    local txt = Instance.new("TextLabel")
                    txt.Name = "ESPLabel"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1 -- พื้นหลังโปร่งใส 100%
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 12
                    txt.TextStrokeTransparency = 0.2
                    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    txt.Parent = bgui
                end

                local txtLabel = bgui:FindFirstChild("ESPLabel")
                if txtLabel then
                    local isHacker = hrp and (hrp.Velocity.Magnitude > ESPSettings.SpeedThreshold)
                    
                    if isHacker then
                        txtLabel.Text = player.DisplayName .. "\n[โปร]"
                        txtLabel.TextColor3 = Color3.fromRGB(255, 30, 30) -- สีแดงเตือนโปร
                    else
                        txtLabel.Text = player.DisplayName
                        txtLabel.TextColor3 = Color3.fromRGB(255, 255, 255) -- สีขาวปกติ
                    end
                end
            else
                if bgui then bgui:Destroy() end
            end
        end

        if player.Character then RefreshNameESP() end
        player.CharacterAdded:Connect(function()
            task.wait(1)
            RefreshNameESP()
        end)

        if safeConnections then
            safeConnections["NameESP_" .. player.Name] = RunService.Heartbeat:Connect(RefreshNameESP)
        end
    end

    -- 5. ผูกปุ่มเข้ากับระบบ UI
    local targetPage = PageMisc or Content:FindFirstChildOfClass("ScrollingFrame")
    if targetPage and type(MakeToggleCard) == "function" then
        MakeToggleCard(targetPage, "3D Body Highlight (PAID💸)", "ไฮไลท์เรืองแสงมองเห็นทะลุกำแพงทั้งตัว", function(on)
            ESPSettings.HighlightEnabled = on
            for _, p in pairs(Players:GetPlayers()) do Apply3DHighlight(p) end
        end)

        MakeToggleCard(targetPage, "Name ESP & Check Hack (PAID💸)", "แสดงชื่อบนหัว + เตือนสีแดงเมื่อเจอคนใช้โปร", function(on)
            ESPSettings.NameESPEnabled = on
            for _, p in pairs(Players:GetPlayers()) do ApplyNameESP(p) end
        end)
    end
end)
    -- ============================================================
    -- 6. ฟังก์ชันดูดปืน/ไอเทมตกพื้น (Weapon & Loot Magnet)
    -- ============================================================
    local MagnetSettings = {
        Enabled = false,
        Radius = 25 -- ระยะการดูด/ขยายการเก็บ (หน่วย Studs) ปรับเพิ่ม-ลดได้ตามต้องการ
    }

    if type(MakeToggleCard) == "function" then
        MakeToggleCard(PageMisc, "ดูดปืน/ไอเทมตกพื้น (Loot Magnet)", "ขยายระยะเก็บปืนและไอเทมดรอปเมื่อเดินผ่าน", function(on)
            MagnetSettings.Enabled = on
            if on then
                safeConnections["ItemMagnet"] = RunService.Heartbeat:Connect(function()
                    if not MagnetSettings.Enabled then return end
                    
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                    local myHrp = char.HumanoidRootPart

                    -- สแกนเฉพาะวัตถุที่เป็น Tool (ปืน/อาวุธ) หรือมีระบบสัมผัสเก็บของใน Workspace
                    for _, obj in pairs(workspace:GetChildren()) do
                        
                        -- กรณีที่ 1: วัตถุเป็น Tool (ปืน/อาวุธที่ตกพื้น)
                        if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                            local handle = obj.Handle
                            local dist = (handle.Position - myHrp.Position).Magnitude
                            
                            if dist <= MagnetSettings.Radius then
                                -- จำลองการแตะสัมผัสเพื่อเก็บเข้าตัวทันที
                                if typeof(firetouchinterest) == "function" then
                                    firetouchinterest(myHrp, handle, 0)
                                    firetouchinterest(myHrp, handle, 1)
                                else
                                    -- สำรอง: ย้ายตำแหน่ง Handle ของปืนมาที่ตัวเราเพื่อส่งผลให้เกิดการเก็บ
                                    handle.CFrame = myHrp.CFrame
                                end
                            end

                        -- กรณีที่ 2: วัตถุเป็น Part ที่มี TouchInterest (ไอเทมดรอปประเภทกล่อง/กระสุน)
                        elseif obj:IsA("BasePart") and obj:FindFirstChildOfClass("TouchInterest") then
                            local dist = (obj.Position - myHrp.Position).Magnitude
                            
                            if dist <= MagnetSettings.Radius then
                                if typeof(firetouchinterest) == "function" then
                                    firetouchinterest(myHrp, obj, 0)
                                    firetouchinterest(myHrp, obj, 1)
                                else
                                    obj.CFrame = myHrp.CFrame
                                end
                            end
                        end

                    end
                end)
            else
                -- ปิดการทำงานและล้างระบบเชื่อมต่อ
                if safeConnections and safeConnections["ItemMagnet"] then
                    safeConnections["ItemMagnet"]:Disconnect()
                    safeConnections["ItemMagnet"] = nil
                end
            end
        end)
    end
