    OFF     = Color3.fromRGB(35,35,35),
    GREEN   = Color3.fromRGB(180,255,200),
    RED     = Color3.fromRGB(255,150,150),
}
local RAD = 10

local function Corner(p,r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,r or RAD); c.Parent = p; return c
end
local function Stroke(p,t,col,tr)
    local s = Instance.new("UIStroke"); s.Thickness=t or 1; s.Color=col or C.BORDER
    s.Transparency=tr or 0; s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; s.Parent=p; return s
end
local function Lbl(p,txt,sz,col,font,xa)
    local l = Instance.new("TextLabel"); l.BackgroundTransparency=1; l.Text=txt
    l.TextSize=sz or 12; l.TextColor3=col or C.WHITE; l.Font=font or Enum.Font.Gotham
    l.TextXAlignment=xa or Enum.TextXAlignment.Left; l.TextWrapped=true; l.Parent=p; return l
end
local function Btn(p,txt,sz,col)
    local b = Instance.new("TextButton"); b.BackgroundColor3=col or C.BG3; b.Text=txt
    b.TextSize=sz or 12; b.TextColor3=C.WHITE; b.Font=Enum.Font.GothamMedium
    b.BorderSizePixel=0; b.AutoButtonColor=false; b.Parent=p; return b
end
local function Tw(obj,t,props)
    TweenService:Create(obj, TweenInfo.new(t,Enum.EasingStyle.Quad,Enum.EasingDirection.Out), props):Play()
end

