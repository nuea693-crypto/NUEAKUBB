local function MakeSliderCard(parent,label,minV,maxV,defV,onChange)
    local card=Instance.new("Frame"); card.Size=UDim2.new(1,0,0,58); card.BackgroundColor3=C.BG2; card.BorderSizePixel=0; card.ZIndex=13; card.Parent=parent; Corner(card,RAD-2); Stroke(card,1,C.BORDER,0.4)
    local mainL=Lbl(card,label,11,C.WHITE,Enum.Font.GothamMedium,Enum.TextXAlignment.Left); mainL.Size=UDim2.new(0.6,0,0,16); mainL.Position=UDim2.new(0,12,0,6); mainL.ZIndex=14
    local valL=Lbl(card,tostring(defV),11,C.WHITE,Enum.Font.GothamBold,Enum.TextXAlignment.Right); valL.Size=UDim2.new(0,50,0,16); valL.Position=UDim2.new(1,-58,0,6); valL.ZIndex=14
    local track=Instance.new("Frame"); track.Size=UDim2.new(1,-24,0,4); track.Position=UDim2.new(0,12,0,38); track.BackgroundColor3=C.OFF; track.BorderSizePixel=0; track.ZIndex=14; track.Parent=card; Corner(track,2)
    local rel0=(defV-minV)/(maxV-minV)
    local fill=Instance.new("Frame"); fill.Size=UDim2.new(rel0,0,1,0); fill.BackgroundColor3=C.WHITE; fill.BorderSizePixel=0; fill.ZIndex=15; fill.Parent=track; Corner(fill,2)
    local sk=Instance.new("Frame"); sk.Size=UDim2.new(0,12,0,12); sk.Position=UDim2.new(rel0,-6,0.5,-6); sk.BackgroundColor3=C.WHITE; sk.BorderSizePixel=0; sk.ZIndex=16; sk.Parent=track; Corner(sk,6)
    local dragging=false
    local shb=Btn(track,"",1,Color3.fromRGB(0,0,0)); shb.BackgroundTransparency=1; shb.Size=UDim2.new(1,0,1,10); shb.Position=UDim2.new(0,0,0,-5); shb.ZIndex=17; shb.Parent=track
    local function upd(x)
        local rel=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(rel,0,1,0); sk.Position=UDim2.new(rel,-6,0.5,-6)
        local v=math.round(minV+rel*(maxV-minV)); valL.Text=tostring(v); onChange(v)
    end
    shb.MouseButton1Down:Connect(function() dragging=true; upd(UserInputService:GetMouseLocation().X) end)
    shb.MouseButton1Up:Connect(function() dragging=false end)
    UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    UserInputService.InputChanged:Connect(function(inp) if dragging and inp.UserInputType==Enum.UserInputType.MouseMovement then upd(inp.Position.X) end end)
end

